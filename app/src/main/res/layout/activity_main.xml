<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/parchment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/terracotta_dark"
        android:elevation="4dp"
        app:titleTextColor="@color/parchment"
        app:title="@string/app_name" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/terracotta"
        app:tabTextColor="@color/parchment_dark"
        app:tabSelectedTextColor="@color/white"
        app:tabIndicatorColor="@color/gold"
        app:tabIndicatorHeight="3dp" />

    <!-- Shown when no file is loaded -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/hint_no_file"
        android:textColor="@color/stone"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.4"
        android:padding="40dp"
        android:visibility="visible" />

    <!-- Hidden until file is loaded -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:background="@color/parchment" />

</LinearLayout>
