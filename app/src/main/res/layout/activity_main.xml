<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/parchment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/terracotta_dark"
        android:elevation="4dp"
        app:titleTextColor="@color/parchment"
        app:title="@string/app_name" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/terracotta"
        app:tabTextColor="@color/parchment_dark"
        app:tabSelectedTextColor="@color/white"
        app:tabIndicatorColor="@color/gold"
        app:tabIndicatorHeight="3dp" />

    <!--
        Welcome / empty state.
        ID kept as tv_empty; Java field type is View (only setVisibility is called).
        Replaced by showEditingView() once a file is loaded.
    -->
    <ScrollView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_title"
                android:textColor="@color/terracotta_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="8dp" />

            <!-- Subtitle rule -->
            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/gold"
                android:layout_marginBottom="28dp" />

            <!-- Step 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step1_title"
                android:textColor="@color/terracotta_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step1_body"
                android:textColor="@color/stone_dark"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"
                android:paddingBottom="20dp" />

            <!-- Step 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step2_title"
                android:textColor="@color/terracotta_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step2_body"
                android:textColor="@color/stone_dark"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"
                android:paddingBottom="20dp" />

            <!-- Step 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step3_title"
                android:textColor="@color/terracotta_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step3_body"
                android:textColor="@color/stone_dark"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"
                android:paddingBottom="20dp" />

            <!-- Step 4 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step4_title"
                android:textColor="@color/terracotta_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step4_body"
                android:textColor="@color/stone_dark"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </ScrollView>

    <!-- Hidden until a file is loaded -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:background="@color/parchment" />

</LinearLayout>
